<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SosOnline</AssemblyName>
    <RootNamespace>SosOnline</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);CS0618;CS8632</NoWarn>
    <!-- Major.minor; the build target appends the commit count (0.1.<count>). -->
    <VersionPrefixBase>0.1</VersionPrefixBase>
    <Version>0.1.0</Version>
    <!-- The commit is appended to the informational version ("0.1.0+e3d3ca0"): logs and the join handshake show it. -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>

    <!-- The game folder: -p:GameDir="D:\Path\To\Sea of Stars", else the SOS_GAME_DIR environment variable, else
         game-dir.txt in the repository root (gitignored; tools\game-dir.ps1 writes it, from Steam's libraries). -->
    <GameDirFile>$(MSBuildThisFileDirectory)..\game-dir.txt</GameDirFile>
    <GameDir Condition="'$(GameDir)' == ''">$(SOS_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(GameDirFile)')">$([System.IO.File]::ReadAllText('$(GameDirFile)').Trim())</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
    <!-- Copy the built plugin into the game after each build (set to false to disable). -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />

    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppSystem.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(Interop)\Rewired_Core.dll" Private="false" />
    <Reference Include="$(Interop)\AK.Wwise.Unity.API.dll" Private="false" />
    <Reference Include="$(Interop)\Sabotage.Core.dll" Private="false" />
    <Reference Include="$(Interop)\Sabotage.StateMachine.dll" Private="false" />
    <Reference Include="$(Interop)\Sabotage.Platform.dll" Private="false" />
    <Reference Include="$(Interop)\Sabotage.Localization.dll" Private="false" />
    <Reference Include="$(Interop)\Facepunch.Steamworks.Win64.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Interop)\Assembly-CSharp.dll" Private="false" />
  </ItemGroup>

  <Target Name="StampCommit" BeforeTargets="InitializeSourceControlInformation;GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
    </Exec>
    <Exec Command="git status --porcelain -- ." ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDirty" />
    </Exec>
    <!-- Build number = commits on HEAD, so versions sort: 0.1.<count>. Automatic updates compare it. -->
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCount" />
    </Exec>
    <PropertyGroup Condition="'$(_GitCount)' != ''">
      <Version>$(VersionPrefixBase).$(_GitCount)</Version>
      <AssemblyVersion>$(VersionPrefixBase).$(_GitCount).0</AssemblyVersion>
      <FileVersion>$(VersionPrefixBase).$(_GitCount).0</FileVersion>
      <InformationalVersion>$(VersionPrefixBase).$(_GitCount)</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(_GitCommit)' != ''">$(_GitCommit)</SourceRevisionId>
      <SourceRevisionId Condition="'$(_GitCommit)' != '' and '$(_GitDirty)' != ''">$(_GitCommit)-modified</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == '' Or !Exists('$(GameDir)\SeaOfStars.exe')"
           Text="Sea of Stars folder not found ('$(GameDir)'). Run tools\game-dir.ps1 once (it finds the game in Steam's libraries and writes game-dir.txt), or pass -p:GameDir=..., or set SOS_GAME_DIR." />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\SosOnline" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(GameDir)\BepInEx\plugins\SosOnline" />
  </Target>

</Project>
